# syntax=docker/dockerfile:1.7
FROM rust:1.93-bookworm AS build
WORKDIR /src
COPY protocol protocol
COPY desktop/src-tauri desktop/src-tauri
RUN --mount=type=cache,id=clawtab-machine-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=clawtab-machine-target,target=/src/desktop/src-tauri/target \
    cd desktop/src-tauri && cargo build -j4 --release --no-default-features --bin clawtab-daemon --bin cwtctl --bin clawtab-hook \
    && mkdir /out && cp target/release/clawtab-daemon target/release/cwtctl target/release/clawtab-hook /out/

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git git-lfs openssh-client tmux python3 procps \
    && rm -rf /var/lib/apt/lists/* \
    && usermod -l clawtab -d /home/clawtab -m node
COPY --from=build /out/ /usr/local/bin/
COPY etc/agent-plugins/ /opt/clawtab/plugins/
COPY etc/machine-entrypoint.sh /usr/local/bin/machine-entrypoint
USER clawtab
WORKDIR /home/clawtab
ENV PATH="/home/clawtab/.local/bin:/usr/local/bin:/usr/bin:/bin"
ENTRYPOINT ["sh", "/usr/local/bin/machine-entrypoint"]
