#compdef cwt

_cwt_jobs() {
  local -a jobs groups
  jobs=(${(f)"$(cwt jobs list 2>/dev/null | awk '
    /^[^[:space:]]/ { group = $0; groups[group] = 1; next }
    /^[[:space:]]/ {
      name = $0
      sub(/^[[:space:]]+/, "", name)
      if (group != "" && name != "") print group "/" name
    }
  ' | sort -u)"})
  groups=(${jobs%%/*})
  compadd -a jobs
  compadd -a groups
}

_cwt_jobs_for_group() {
  local group="$1"
  local -a jobs
  jobs=(${(f)"$(cwt jobs list 2>/dev/null | awk -v wanted="$group" '
    /^[^[:space:]]/ { group = $0; next }
    /^[[:space:]]/ {
      name = $0
      sub(/^[[:space:]]+/, "", name)
      if (group == wanted && name != "") print name
    }
  ' | sort -u)"})
  compadd -a jobs
}

_cwt_panes() {
  local -a panes
  panes=(${(f)"$(tmux list-panes -a -F '#{pane_id}' 2>/dev/null | sort -u)"})
  compadd -a panes
}

_cwt_sessions() {
  local -a sessions
  sessions=(${(f)"$(cwt session list 2>/dev/null | cut -f1)"})
  compadd -a sessions
}

_cwt_plugins() {
  local -a plugins
  plugins=('list:List available agent plugins')
  plugins+=(${(f)"$(cwt plugin list 2>/dev/null | awk -F '\t' '
    {
      id = $1
      sub(/^.*\./, "", id)
      gsub(/_/, "-", id)
      if (id != "") print id ":" $2
    }
  ' | sort -u)"})
  _describe -t plugins 'plugin name' plugins
}

_cwt_secret_keys() {
  local -a keys
  keys=(${(f)"$(cwt secrets 2>/dev/null | awk 'NF')"})
  compadd -a keys
}

_cwt_complete() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a top_cmds
  top_cmds=(
    'login:Sign in or replace the current account'
    'jobs:Job management'
    'usage:Show local provider quota usage'
    'agent:Agent pane controls'
    'plugin:Run catalog agent plugins'
    'secrets:Manage secrets'
    'message:Messages and human input'
    'pane:Pane controls'
    'session:Manage durable CLI sessions'
    'daemon:Daemon management'
  )

  _arguments -C \
    '1: :->cmd' \
    '*:: :->args'

  case $state in
    cmd)
      _describe -t commands 'cwt command' top_cmds
      ;;
    args)
      case $words[1] in
        message|nfn)
          if (( CURRENT == 2 )); then
            local -a sub
            sub=('send:Send a message' 'list:List pending messages and history' 'get:Get a message and its response' 'wait:Wait for a response' 'reply:Reply or choose an action' 'read:Mark a message read' 'dismiss:Dismiss a message' 'cancel:Cancel a message' 'focus:Show and focus a message on desktop' 'show:Open the message queue' 'settings:Read or apply message settings' 'templates:List or validate layouts')
            _describe -t subcmd 'message command' sub
          elif [[ $words[2] == templates && CURRENT == 3 ]]; then
            compadd list validate
          elif [[ $words[2] == templates && $words[3] == validate ]]; then
            _files
          elif [[ $words[2] == send ]]; then
            case $words[CURRENT-1] in
              --kind) compadd update question approval completed failed ;;
              --channel) compadd desktop mobile telegram ;;
              --response-destination) compadd result agent_message ;;
              *) compadd -- --stdin --wait --timeout --template --kind --channel --choice --title --chat --response-destination ;;
            esac
          elif [[ $words[2] == list ]]; then
            compadd -- --pending --offset
          elif [[ $words[2] == reply ]]; then
            compadd -- --action
          elif [[ $words[2] == wait ]]; then
            compadd -- --timeout
          elif [[ $words[2] == settings ]]; then
            compadd -- --stdin --ui --json
            _files -g '*.yaml'
          fi
          ;;
        login)
          words=("${words[@]:1}")
          (( CURRENT-- ))
          _arguments \
            '(- *)'{-h,--help}'[Show login help]' \
            '(--email)--provider[Browser sign-in provider]:provider:(google apple)' \
            '(--provider --no-browser)--email[Sign in with a hidden password]:email:' \
            '--relay[Relay server URL]:URL:' \
            '--name[Machine name]:name:' \
            '(--email)--no-browser[Print the sign-in URL without opening a browser]'
          ;;
        jobs)
          if (( CURRENT == 2 )); then
            local -a sub
            sub=(
              'list:List jobs grouped by group'
              'ls:List jobs grouped by group'
              'run:Run a job and follow its output'
              'pause:Pause a running job'
              'resume:Resume a paused job'
              'restart:Restart a job'
              'status:Show job statuses'
              'create:Create a scheduled agent job'
              'edit:Edit job YAML in nvim; enable or disable scheduling'
            )
            _describe -t subcmd 'jobs subcommand' sub
          elif [[ $words[2] == create ]]; then
            words=("${words[@]:1}")
            (( CURRENT-- ))
            _arguments \
              '(- *)'{-h,--help}'[Show job creation help]' \
              '--name[Name of the new job]:job name:' \
              '--provider[Agent CLI for this job]:provider:(claude codex opencode antigravity hermes)' \
              '--model[Model for the selected provider; OpenCode uses provider/model]:model:' \
              '(--at --keep-config)--cron[Repeat on a cron schedule]:cron expression:' \
              '(--cron)--at[Run once at a future local time or RFC 3339 timestamp]:date and time:' \
              '(--description-file --description-stdin)--description[Job instructions]:description:' \
              '(--description --description-stdin)--description-file[Read job instructions from a file]:description file:_files' \
              '(--description --description-file)--description-stdin[Read job instructions from stdin]' \
              '(--cron)--keep-config[Keep a one-time job disabled after it starts]'
          elif (( CURRENT == 3 )) && [[ $words[2] == run || $words[2] == pause || $words[2] == resume || $words[2] == restart || $words[2] == edit ]]; then
            _cwt_jobs
          elif (( CURRENT == 4 )) && [[ $words[2] == run || $words[2] == pause || $words[2] == resume || $words[2] == restart || $words[2] == edit ]] && [[ $words[3] != */* ]]; then
            _cwt_jobs_for_group "$words[3]"
          fi
          ;;
        session)
          if (( CURRENT == 2 )); then
            local -a sub
            sub=(
              'start:Start a durable terminal session'
              'list:List managed sessions'
              'attach:Attach to a running session'
              'capture:Print a session screen or history'
              'stop:Stop a managed session'
              'resume:Resume a managed session'
              'help:Show session usage'
            )
            _describe -t subcmd 'session subcommand' sub
          elif [[ $words[2] == start ]]; then
            local command_index=${words[(i)--]}
            if (( command_index < CURRENT )); then
              words=("${words[@]:$command_index}")
              (( CURRENT -= command_index ))
              _normal
            else
              words=("${words[@]:1}")
              (( CURRENT-- ))
              _arguments -S \
                '(--close-with-terminal)--detached[Start without attaching this terminal]' \
                '(--detached --keep-running)--close-with-terminal[Stop when this terminal closes]' \
                '(--close-with-terminal)--keep-running[Keep running when this terminal closes]' \
                '--[Start the program and its arguments]'
            fi
          else
            words=("${words[@]:1}")
            (( CURRENT-- ))
            case $words[1] in
              list)
                _arguments '--json[Output sessions as JSON]'
                ;;
              attach|stop|resume)
                _arguments '1:session ID:_cwt_sessions'
                ;;
              capture)
                _arguments \
                  '--history[Include retained terminal history]' \
                  '--ansi[Include ANSI terminal formatting]' \
                  '1:session ID:_cwt_sessions'
                ;;
            esac
          fi
          ;;
        usage)
          if (( CURRENT == 2 )); then
            local -a providers
            providers=(claude codex antigravity zai)
            compadd -a providers
          fi
          ;;
        agent)
          if (( CURRENT == 2 )); then
            local -a sub
            sub=(
              'auto-yes:Manage auto-yes for a pane'
              'info:Show agent session info'
              'identities:List live tmux agent identities as JSON'
              'rename:Rename an agent pane'
              'pin:Pin an agent across ClawTab'
              'unpin:Unpin an agent across ClawTab'
              'ai-rename:Generate a concise pane title'
              'hooks:Manage agent event hooks'
            )
            _describe -t subcmd 'agent subcommand' sub
          elif (( CURRENT == 3 )) && [[ $words[2] == auto-yes ]]; then
            local -a sub
            sub=(
              'toggle:Toggle auto-yes for pane'
              'check:Check if pane has auto-yes'
            )
            _describe -t subcmd 'auto-yes subcommand' sub
            _cwt_panes
          elif (( CURRENT == 4 )) && [[ $words[2] == auto-yes ]] && [[ $words[3] == toggle || $words[3] == check ]]; then
            _cwt_panes
          elif (( CURRENT == 3 )) && [[ $words[2] == info ]]; then
            local -a sub
            sub=(
              '--fast:Skip expensive provider detail parsing'
              'restore-command:Print an agent restore command'
            )
            _describe -t subcmd 'info subcommand' sub
            _cwt_panes
          elif (( CURRENT == 4 )) && [[ $words[2] == info && $words[3] == restore-command ]]; then
            _cwt_panes
          elif (( CURRENT == 4 )) && [[ $words[2] == info && $words[3] == --fast ]]; then
            _cwt_panes
          elif (( CURRENT == 3 )) && [[ $words[2] == rename || $words[2] == ai-rename || $words[2] == pin || $words[2] == unpin ]]; then
            _cwt_panes
          elif (( CURRENT == 3 )) && [[ $words[2] == hooks ]]; then
            local -a actions
            actions=(
              'status:Show hook installation status'
              'install:Install provider hooks'
            )
            _describe -t subcmd 'hooks subcommand' actions
          elif (( CURRENT == 4 )) && [[ $words[2] == hooks ]] && [[ $words[3] == status || $words[3] == install ]]; then
            local -a providers
            providers=(claude codex opencode antigravity hermes)
            compadd -a providers
          fi
          ;;
        plugin)
          if (( CURRENT == 2 )); then
            _cwt_plugins
          elif (( CURRENT == 3 )) && [[ $words[2] == list ]]; then
            _cwt_panes
            compadd -- --json
          elif (( CURRENT == 3 )); then
            local -a operations
            operations=(
              'run:Start the plugin action'
              'status:Show a plugin run'
              'cancel:Cancel a plugin run'
            )
            _describe -t subcmd 'plugin operation' operations
          elif (( CURRENT == 4 )) && [[ $words[3] == run ]]; then
            _cwt_panes
          fi
          ;;
        secrets)
          if (( CURRENT == 2 )); then
            local -a sub
            sub=(
              'get:Get secret value(s)'
              'insert:Prompt for and store a secret'
              'delete:Delete a secret'
            )
            _describe -t subcmd 'secrets subcommand' sub
          elif (( CURRENT >= 3 )) && [[ $words[2] == get ]]; then
            _cwt_secret_keys
          elif (( CURRENT == 3 )) && [[ $words[2] == insert || $words[2] == delete ]]; then
            compadd -- --yes -y
            _cwt_secret_keys
          elif (( CURRENT == 4 )) && [[ $words[2] == insert || $words[2] == delete ]] && [[ $words[3] == --yes || $words[3] == -y ]]; then
            _cwt_secret_keys
          elif (( CURRENT == 4 )) && [[ $words[2] == insert || $words[2] == delete ]]; then
            compadd -- --yes -y
          fi
          ;;
        pane)
          if (( CURRENT == 2 )); then
            local -a sub
            sub=(
              'open:Open tmux pane in ClawTab'
              'focus:Move focus between ClawTab panes'
            )
            _describe -t subcmd 'pane subcommand' sub
          elif (( CURRENT == 3 )) && [[ $words[2] == open ]]; then
            _cwt_panes
          elif (( CURRENT == 3 )) && [[ $words[2] == focus ]]; then
            local -a dirs
            dirs=(left right up down)
            compadd -a dirs
          fi
          ;;
        daemon)
          if (( CURRENT == 2 )); then
            local -a sub
            sub=(
              'install:Install launchd service'
              'stop:Stop daemon but keep launchd service installed'
              'uninstall:Remove launchd service'
              'ping:Check if daemon is running'
              'status:Check if daemon is running'
              'restart:Restart the daemon'
              'logs:Show daemon logs'
            )
            _describe -t subcmd 'daemon subcommand' sub
          fi
          ;;
        telegram)
          if (( CURRENT == 2 )); then
            local -a sub
            sub=('send:Send a message')
            _describe -t subcmd 'telegram subcommand' sub
          fi
          ;;
      esac
      ;;
  esac
}

# Zsh caches this entry point in each shell. Read the installed file again on
# the next completion so an atomic local install takes effect immediately.
_cwt() {
  source "${functions_source[_cwt]}" "$@"
}

_cwt_complete "$@"
